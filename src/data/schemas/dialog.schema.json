{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialog.schema.json",
  "title": "Dialog Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "steps"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["background", "msg_type", "message"],
        "properties": {
          "background": {
            "type": "string",
            "minLength": 1
          },
          "standing": {
            "type": "string"
          },
          "msg_type": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
