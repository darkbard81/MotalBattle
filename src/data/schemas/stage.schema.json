{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage.schema.json",
  "title": "Stage Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "width",
    "height",
    "terrain",
    "units"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "background_path": {
      "type": "string",
      "minLength": 1
    },
    "image_area": {
      "$ref": "./image-area.schema.json"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "terrain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "enum": [
            "floor",
            "wall",
            "hazard"
          ]
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unitId",
          "x",
          "y"
        ],
        "properties": {
          "unitId": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "turnLimit": {
      "type": "integer",
      "minimum": 0
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "defeat_all"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "turn"
            ],
            "properties": {
              "type": {
                "const": "survive_n_turns"
              },
              "turn": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      }
    }
  }
}
